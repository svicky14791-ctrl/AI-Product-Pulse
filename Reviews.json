    {
      "parameters": {
        "jsCode": "// Read the uploaded CSV as plain text so commas inside reviews don't break parsing\nconst text = String($input.first().json.text || '');\nconst lines = text\n .replace(/^\\uFEFF/, '')\n .split(/\\r?\\n/)\n .map(l => l.trim())\n .filter(l => l.length > 0);\n// Drop the first line only if it looks like a header (e.g. \"review\")\nconst hasHeader = lines.length > 0 && /^\"?(reviews?|text|comments?|feedback)\"?$/i.test(lines[0]);\nconst reviews = (hasHeader ? lines.slice(1) : lines)\n .map(l => l.replace(/^\"(.*)\"$/, '$1').replace(/\"\"/g, '\"'))\n .join('\\n');\nreturn [{\n json: {\n   reviews\n }\n}];"
      },
      "id": "49b1205d-dd97-4bb7-b84d-eca6bd872c79",
      "name": "Combine Reviews",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
